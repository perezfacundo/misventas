# Dominio que apunta a este servidor (registro DNS tipo A). Caddy saca el certificado HTTPS solo.
DOMAIN=ventas.tukiosco.com.ar
# Contraseña de la base de datos: larga y aleatoria (por ejemplo: openssl rand -base64 32).
POSTGRES_PASSWORD=
# Clave para cifrar los tokens de Mercado Pago guardados en la base. No la cambies después de configurar MP.
APP_SECRET=
