{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mis Ventas",
  "version": "0.1.0",
  "identifier": "ar.misventas.escritorio",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @misventas/web",
    "beforeBuildCommand": "npm run build -w @misventas/web"
  },
  "app": {
    "windows": [
      {
        "title": "Mis Ventas",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Vender, cobrar y controlar el stock del kiosco",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libcups2"
        ]
      }
    }
  }
}
